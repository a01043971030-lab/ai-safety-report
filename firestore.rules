rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny other paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow read/write access to safety_reports collection
    match /safety_reports/{reportId} {
      allow read, write: if true;
    }

    // Allow read/write access to users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Allow read/write access to notices collection
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // Allow read/write access to login_logs collection
    match /login_logs/{logId} {
      allow read, write: if true;
    }
  }
}
